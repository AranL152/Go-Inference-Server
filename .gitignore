# Build artifacts
/server
/loadtest/loadtest

# Native libraries: too large for git and machine-specific. See SETUP.md.
/onnxruntime/
/cudnn9/

# Scratch
*.tmp
*_results.json
*_results.csv

# Local editor / tooling settings
.claude/
.vscode/

# TensorRT engine cache
/trt_cache/

# Saved detection jobs and uploads
/jobs/

# Nsight reports (open with ncu-ui or nsys-ui) are large so only the JSON summaries are kept
/profiles/*.ncu-rep
/profiles/*.nsys-rep

# Raw trace and CPU profile captures from the dashboard
/profiles/trace-*
/profiles/cpu-*
